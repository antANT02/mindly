generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum QualidadeRevisao {
  DIFICIL
  BOM
  FACIL
}

enum PapelGrupo {
  OWNER
  MEMBER
}

enum PresenceStatus {
  ONLINE
  STUDYING
  BUSY
  OFFLINE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskBoardStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model User {
  id                    String             @id @default(cuid())
  name                  String
  username              String?            @unique
  email                 String             @unique
  emailVerified         Boolean            @default(false)
  role                  String             @default("USER")
  image                 String?
  avatarUrl             String?
  bio                   String?            @db.VarChar(280)
  statusText            String?            @db.VarChar(120)
  presence              PresenceStatus     @default(ONLINE)
  xp                    Int                @default(0)
  streakDays            Int                @default(0)
  metaDiariaMinutos     Int                @default(120)
  fatorFacilidadePadrao Float              @default(2.5)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  sessions               Session[]
  accounts               Account[]
  disciplinas            Disciplina[]
  tarefas                Tarefa[]
  metas                  Meta[]
  sessoesEstudo          SessaoEstudo[]
  gruposCriados          StudyGroup[]       @relation("GrupoProprietario")
  membrosGrupos          StudyGroupMember[]
  conclusoesTarefa       TarefaConclusao[]

  sentFriendRequests     Friendship[]       @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]       @relation("FriendshipAddressee")
  ownedConsoleGroups     StudyGroup[]       @relation("ConsoleGroupOwner")
  consoleGroupMembers    GroupMember[]
  subjects               Subject[]
  createdTasks           Task[]             @relation("TaskCreator")
  taskAssignments        TaskAssignee[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

model StudyGroup {
  id           String             @id @default(cuid())
  name         String
  description  String?            @db.VarChar(400)
  bannerColor  String             @default("#1E3A2F")
  inviteCode   String             @unique
  ownerId      String
  owner        User               @relation("GrupoProprietario", fields: [ownerId], references: [id], onDelete: Cascade)
  consoleOwner User?              @relation("ConsoleGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade, map: "StudyGroup_consoleOwnerId_fkey")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members        StudyGroupMember[]
  consoleMembers GroupMember[]
  disciplinas    Disciplina[]
  tarefas        Tarefa[]
  subjects       Subject[]
  tasks          Task[]

  @@index([ownerId])
}

model StudyGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  userId   String
  role     PapelGrupo @default(MEMBER)
  joinedAt DateTime   @default(now())

  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupMember {
  id       String          @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  group    StudyGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model Subject {
  id          String      @id @default(cuid())
  name        String
  code        String?
  accentColor String      @default("#66C0F4")
  coverImage  String?
  userId      String
  groupId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       StudyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([userId])
  @@index([groupId])
}

model Task {
  id          String          @id @default(cuid())
  title       String
  description String?
  priority    TaskPriority    @default(MEDIUM)
  status      TaskBoardStatus @default(TODO)
  dueDate     DateTime?
  subjectId   String?
  groupId     String?
  creatorId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subject     Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  group       StudyGroup?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator     User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignees   TaskAssignee[]

  @@index([subjectId])
  @@index([groupId])
  @@index([creatorId])
}

model TaskAssignee {
  id                  String   @id @default(cuid())
  taskId              String
  userId              String
  completedIndividual Boolean  @default(false)
  assignedAt          DateTime @default(now())

  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Disciplina {
  id           String         @id @default(cuid())
  nome         String
  descricao    String?
  corHex       String         @default("#3D4F3D")
  metaHorasSem Int            @default(6)
  publica      Boolean        @default(false)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGroupId String?
  studyGroup   StudyGroup?    @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tarefas      Tarefa[]
  sessoes      SessaoEstudo[]
  metas        Meta[]

  @@index([userId])
  @@index([studyGroupId])
}

model Tarefa {
  id               String            @id @default(cuid())
  titulo           String
  descricao        String?
  notas            String?
  estimativaMin    Int               @default(25)
  status           StatusTarefa      @default(PENDENTE)
  srsIntervalo     Int               @default(1)
  proximaRevisao   DateTime?
  proximaRevisaoEm DateTime?
  ultimaQualidade  QualidadeRevisao?
  intervaloDias    Int               @default(1)
  repeticoes       Int               @default(0)
  fatorFacilidade  Float             @default(2.5)
  disciplinaId     String
  disciplina       Disciplina        @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGroupId     String?
  studyGroup       StudyGroup?       @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  conclusoes       TarefaConclusao[]

  @@index([disciplinaId])
  @@index([userId])
  @@index([studyGroupId])
}

model TarefaConclusao {
  id          String   @id @default(cuid())
  tarefaId    String
  userId      String
  completedAt DateTime @default(now())

  tarefa      Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, userId])
  @@index([tarefaId])
  @@index([userId])
}

model Meta {
  id           String      @id @default(cuid())
  titulo       String
  descricao    String?
  horasAlvo    Float
  horasAtuais  Float       @default(0)
  prazo        DateTime?
  disciplinaId String?
  disciplina   Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([disciplinaId])
}

model SessaoEstudo {
  id           String     @id @default(cuid())
  duracaoMin   Int
  modo         String     @default("POMODORO")
  anotacao     String?
  anotacoesZen String?
  concluidaEm  DateTime   @default(now())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([disciplinaId])
  @@index([userId])
}